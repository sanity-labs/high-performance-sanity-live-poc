# Copy to .env to override the defaults baked into the package.json scripts.
# Everything in here is public configuration; secrets never belong in this file.

# Gateway request deduplication toggle (true/false). `pnpm dev:no-dedup` sets it to false.
PLT_DEDUP=true

# Number of Next.js workers inside the Watt runtime.
# The default is 1: with the default in-memory Next.js caches, updateTag()
# only invalidates the worker that ran the server action, so multi-worker
# setups serve stale content. Use the Valkey profile (pnpm dev:valkey) to run
# multiple workers with a shared, coherent cache.
PLT_NEXT_WORKERS=1

# Valkey scale-out profile (`pnpm dev:valkey`; requires
# `docker compose up -d valkey` or any Redis-compatible server).
PLT_VALKEY_URL=redis://127.0.0.1:6379

# Sanity project (public values, safe to commit).
NEXT_PUBLIC_SANITY_PROJECT_ID=ppsg7ml5
NEXT_PUBLIC_SANITY_DATASET=watt
